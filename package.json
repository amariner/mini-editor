{
  "name": "agent-desk",
  "version": "0.1.8",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev:local": "AGENT_DESK_DATA_DIR=artifacts/local-dev/data node scripts/dev.mjs",
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && vite build && node scripts/build.mjs",
    "package:mac": "node scripts/package-mac.mjs",
    "test:package": "node scripts/package-check.mjs",
    "start": "electron .",
    "test": "tsx --test tests/*.test.ts tests/*.test.mjs",
    "test:integration": "npm run build && node scripts/integration.mjs",
    "test:chat": "npm run build && node scripts/chat-check.mjs",
    "postinstall": "electron-rebuild -f -w node-pty",
    "test:models": "npm run build && node scripts/codex-models-check.mjs",
    "test:runtime": "npm run build && node scripts/runtime-check.mjs",
    "test:accounts": "npm run build && node scripts/accounts-check.mjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.291",
    "@anthropic-ai/claude-code": "^2.1.291",
    "@google/gemini-cli": "0.66.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@opencode/cli": "2.2.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "lucide-react": "^1.64.0",
    "node-pty": "^1.1.0",
    "playwright-core": "1.64.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.1.0",
    "esbuild": "^0.28.2",
    "playwright": "^1.58.0",
    "prettier": "^3.9.9",
    "tsx": "^4.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
